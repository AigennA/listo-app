<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: merged into the main manifest, never present in release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Exported so adb can trigger it; see DemoDataReceiver for the command. -->
        <receiver
            android:name=".debug.DemoDataReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.listo.app.debug.SEED_DEMO" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
