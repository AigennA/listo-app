            android:fillColor="#40916C"
            android:pathData="M162,290 A18,18 0 1,0 198,290 A18,18 0 1,0 162,290 Z" />
        <path
            android:pathData="M171,290 L178,297 L190,283"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:fillColor="#B7D3C4"
            android:pathData="M221,283 L313,283 A7,7 0 0,1 313,297 L221,297 A7,7 0 0,1 221,283 Z" />

        <!-- Row 3: still to buy -->
        <path
            android:pathData="M165,350 A15,15 0 1,0 195,350 A15,15 0 1,0 165,350 Z"
