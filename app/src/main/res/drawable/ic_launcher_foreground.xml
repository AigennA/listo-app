    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="10.8"
        android:translateY="13.1625"
        android:scaleX="0.16875"
        android:scaleY="0.16875">

        <!-- Sprout (as in SplashScreen.kt), scaled 0.4; its stem base hides behind the card. -->
        <group
            android:translateX="201.2"
            android:translateY="80.88"
            android:scaleX="0.4"
            android:scaleY="0.4">
            <path
                android:pathData="M137,260.3 Q131.52,150.7 137,82.2"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="24.66"
                android:strokeLineCap="round" />
            <group
                android:pivotX="137"
                android:pivotY="115.08"
                android:rotation="-38">
                <path
                    android:fillColor="#FFFFFF"
                    android:pathData="M137,115.08 Q200.29,51.79 137,0 Q73.71,51.79 137,115.08 Z" />
            </group>
            <group
                android:pivotX="137"
                android:pivotY="93.16"
                android:rotation="32">
