            android:pathData="M164,170 L348,170 A28,28 0 0,1 376,198 L376,382 A28,28 0 0,1 348,410 L164,410 A28,28 0 0,1 136,382 L136,198 A28,28 0 0,1 164,170 Z" />

        <!-- Row 1: ticked -->
        <path
            android:fillColor="#40916C"
            android:pathData="M162,230 A18,18 0 1,0 198,230 A18,18 0 1,0 162,230 Z" />
        <path
            android:pathData="M171,230 L178,237 L190,223"
