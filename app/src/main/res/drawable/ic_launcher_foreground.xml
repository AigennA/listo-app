<?xml version="1.0" encoding="utf-8"?>
<!--
  The Listo sprout, same geometry as store/graphics/icon-512.html and
  SplashScreen.kt. The outer group maps the 512px store artwork onto the
  72dp area a launcher mask shows (offset 18dp), so the sprout stays inside
  the 66dp safe zone of the 108dp adaptive icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="18"
        android:translateY="18"
        android:scaleX="0.140625"
        android:scaleY="0.140625">

        <!-- The store artwork's inner 274x320 box, placed at (86,104) and scaled to 330px. -->
        <group
            android:translateX="109.72"
            android:translateY="150.41"
            android:scaleX="1.03125"
            android:scaleY="1.03125">

            <path
                android:pathData="M137,260.3 Q131.52,150.7 137,82.2"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="24.66"
                android:strokeLineCap="round" />

            <group
                android:pivotX="137"
                android:pivotY="115.08"
                android:rotation="-38">
                <path
                    android:fillColor="#FFFFFF"
                    android:pathData="M137,115.08 Q200.29,51.79 137,0 Q73.71,51.79 137,115.08 Z" />
            </group>

            <group
                android:pivotX="137"
                android:pivotY="93.16"
                android:rotation="32">
                <path
                    android:fillColor="#FFFFFF"
                    android:pathData="M137,93.16 Q206.32,23.84 137,-32.88 Q67.68,23.84 137,93.16 Z" />
            </group>
        </group>
    </group>
</vector>
