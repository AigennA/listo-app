<?xml version="1.0" encoding="utf-8"?>
<!--
  The Listo icon: a shopping-list card with the Listo sprout growing out of its
  top. Same geometry as store/graphics/icon-512.html, drawn in its 512px
  coordinates; the outer group applies the store file's 1.2x content scale and
  maps 512px onto the 72dp a launcher mask shows, keeping the artwork inside
  the 66dp safe zone of the 108dp adaptive icon.
-->
